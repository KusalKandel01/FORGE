# Copy this file to .env for local development (the real .env is never committed).

# Local database (default SQLite)
DATABASE_URL="file:./db/custom.db"

# AI features (book guides, tutors, plans) - any OpenAI-compatible provider.
# Free keys: https://console.groq.com  or  https://aistudio.google.com
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# Optional: Turso cloud sync (https://turso.tech)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
