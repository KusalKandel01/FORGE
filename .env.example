# Copy this file to .env for local development (the real .env is never committed).

# Local database (default SQLite)
DATABASE_URL="file:./db/custom.db"

# AI features (book guides, tutors, plans).
# Recommended: Z.ai - free key from the Z.ai Open Platform.
# Any OpenAI-compatible provider also works (Groq, Google AI Studio, OpenAI...).
# AI_API_KEY=
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4.5-flash

# Cloud database (Turso free tier, https://turso.tech).
# When set, cloud sync and the shared real-photo cache are stored in Turso
# instead of the local SQLite file - same code path as production.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
